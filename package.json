{
  "name": "agent-switch-profile",
  "version": "0.1.0",
  "description": "Manage multiple Claude Code login profiles via isolated config dirs and shell aliases",
  "keywords": ["claude-code", "profile", "cli", "multi-account"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinhltt/agent-switch-profile.git"
  },
  "type": "module",
  "bin": {
    "asp": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target node --banner '#!/usr/bin/env node'",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1",
    "commander": "^13",
    "picocolors": "^1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
